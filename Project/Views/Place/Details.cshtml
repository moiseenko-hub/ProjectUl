@using Project.Models.Database
@model PlaceData

@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>

@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded" />
}

<p class="mt-3">@Model.FullDescription</p>

<h4>Типы:</h4>
<ul class="list-inline">
    @foreach (var t in Model.Types)
    {
        <li class="list-inline-item">
            <span class="badge bg-primary">@t.Name</span>
        </li>
    }
</ul>

<h4>Отзывы:</h4>
<ul class="list-group">
    @foreach (var review in Model.Reviews)
    {
        <li class="list-group-item">
            <b>@review.User.Username</b>: @review.Text
        </li>
    }
</ul>

@if (User.Identity.IsAuthenticated)
{
    <form method="post" asp-action="AddReview" class="mt-3">
        <input type="hidden" name="placeId" value="@Model.Id" />
        <div class="mb-3">
            <textarea name="text" class="form-control" placeholder="Ваш отзыв..." rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Оставить отзыв</button>
    </form>
}
